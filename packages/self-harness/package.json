{
  "name": "@hyperframes/self-harness",
  "version": "0.1.0",
  "description": "Self-Harness: an agent that clusters its own failures and proposes regression-gated edits to its own harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/heygen-com/hyperframes",
    "directory": "packages/self-harness"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc",
    "demo": "tsx src/demo/run-demo.ts",
    "demo:loop": "tsx src/demo/run-loop.ts",
    "demo:apis": "tsx src/examples/public-apis/run.ts",
    "demo:apis:model": "tsx src/examples/public-apis/run.ts --model",
    "demo:bruno": "tsx src/examples/bruno/run.ts",
    "demo:ds": "tsx src/examples/data-science/run.ts",
    "demo:ds:agentic": "tsx src/examples/data-science/run.ts --agentic",
    "demo:ds:model": "tsx src/examples/data-science/run.ts --model",
    "demo:ds:committee": "tsx src/examples/data-science/run.ts --committee",
    "demo:ds:refine": "tsx src/examples/data-science/run.ts --refine",
    "demo:osint": "tsx src/examples/osint/run.ts",
    "demo:osint:model": "tsx src/examples/osint/run.ts --model",
    "demo:osint:committee": "tsx src/examples/osint/run.ts --committee",
    "demo:brain": "tsx src/examples/company-brain/run.ts",
    "demo:router": "tsx src/examples/router/run.ts",
    "demo:router:real": "tsx src/examples/router/real-eval.ts",
    "demo:router:real:live": "tsx src/examples/router/real-eval.ts --live",
    "demo:router:real:bayes": "tsx src/examples/router/bayes-eval.ts",
    "demo:ta": "tsx src/examples/technical-analysis/run.ts",
    "demo:cost": "tsx src/examples/cost-router/run.ts",
    "demo:money": "tsx src/examples/cost-router/billing-run.ts",
    "demo:mcp": "tsx src/examples/mcp-node/run.ts",
    "demo:scan": "tsx src/examples/mcp-node/scorecard-run.ts",
    "demo:registry": "tsx src/examples/mcp-node/registry-run.ts",
    "demo:names": "tsx src/examples/mcp-node/names-run.ts",
    "demo:confirm": "tsx src/examples/mcp-node/confirm-run.ts",
    "demo:deep": "tsx src/examples/mcp-node/deep-scan-run.ts",
    "demo:benchmark": "tsx src/benchmark/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
