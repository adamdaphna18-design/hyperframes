{
  "name": "fix-engine",
  "version": "0.1.0",
  "description": "Dev-time click-to-fix queue for any web app: Alt+click an element, write one line, an agent fixes the batch. Ships a context package so the agent skips the discovery round-trip.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "fix-queue": "bin/fix-queue.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "serve": "bun run src/server.ts"
  },
  "keywords": ["dev-tools", "click-to-fix", "annotation", "kanban", "agent", "context-capture"],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  }
}
