{
  "name": "butterflyledger",
  "version": "0.1.0",
  "description": "A zero-knowledge, SHA-256 blockchain ledger for every action an AI agent takes, grounded in butterfly-effect (chaos) theory.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "bin": {
    "butterflyledger": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "demo": "bun run src/demo.ts",
    "cli": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "blockchain",
    "ledger",
    "zero-knowledge",
    "zkp",
    "schnorr",
    "sha256",
    "ai-agent",
    "butterfly-effect",
    "chaos-theory",
    "audit"
  ],
  "license": "MIT"
}
